---
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const t = ru ? {
  title: 'Быстрые рецепты',
  intro: 'Не знаешь название метода? Ищи по задаче: «сохранить число», «событие», «ошибка», «UI».',
  search: 'Что ты хочешь сделать?',
  all: 'Все', start: 'Старт', data: 'Данные', events: 'События', actions: 'Actions', world: 'Мир', ui: 'UI', debug: 'Отладка',
  beginner: 'Новичок', intermediate: 'Средний',
  open: 'Открыть рецепт →',
  empty: 'Ничего не нашлось. Попробуй короче: data, event, UI, crash…',
  shown: 'Показано', of: 'из', clear: 'Сбросить'
} : {
  title: 'Quick recipes',
  intro: 'Do not know the method name? Search by task: “save number”, “event”, “error”, “UI”.',
  search: 'What do you want to do?',
  all: 'All', start: 'Start', data: 'Data', events: 'Events', actions: 'Actions', world: 'World', ui: 'UI', debug: 'Debug',
  beginner: 'Beginner', intermediate: 'Intermediate',
  open: 'Open recipe →',
  empty: 'Nothing found. Try a shorter word: data, event, UI, crash…',
  shown: 'Showing', of: 'of', clear: 'Reset'
};

const items = [
  {cat:'start', icon:'MOD', level:'beginner', title:ru?'Создать самый маленький мод':'Create the smallest mod', desc:ru?'Сгенерировать `mod.json` и `Main.cs`, запустить игру и проверить загрузку.':'Generate `mod.json` and `Main.cs`, run the game, and verify it loaded.', terms:'first mod start create generate mod json main cs load', href:'../workbench/mod-generator/'},
  {cat:'data', icon:'SAVE', level:'beginner', title:ru?'Сохранить число за королевством':'Save a number on a kingdom', desc:ru?'Минимальный путь к `SetKingdomInt` / `GetKingdomInt` и границам persistence.':'Minimal route to `SetKingdomInt` / `GetKingdomInt` and persistence boundaries.', terms:'save data kingdom int number persistence', href:'../guides/kingdom-custom-data/'},
  {cat:'data', icon:'PARTY', level:'intermediate', title:ru?'Хранить данные партии':'Store data on a party', desc:ru?'Typed party data, fallback для missing party и lifecycle inactive/reactivate.':'Typed party data, missing-party fallback, and inactive/reactivate lifecycle.', terms:'party data save string bool float int inactive', href:'../api/politicalworld-party-private-data/'},
  {cat:'events', icon:'EVENT', level:'intermediate', title:ru?'Подписаться на политическое событие':'Subscribe to a political event', desc:ru?'Подписка, unsubscribe, wildcard, callback isolation и payload behavior.':'Subscribe, unsubscribe, wildcard, callback isolation, and payload behavior.', terms:'event subscribe callback political event bus wildcard', href:'../api/politicalworld-event-bus/'},
  {cat:'actions', icon:'ACT', level:'intermediate', title:ru?'Создать action с condition':'Create an action with a condition', desc:ru?'RegisterAction, CanExecute, Execute, TryExecute и Effects.Sequence.':'RegisterAction, CanExecute, Execute, TryExecute, and Effects.Sequence.', terms:'action condition effect register execute sequence', href:'../api/politicalworld-actions-conditions-effects/'},
  {cat:'world', icon:'WORLD', level:'intermediate', title:ru?'Изменить высоту тайла':'Change tile height', desc:ru?'Проверенное отличие `WorldTile.Height` / `data.height` от ложного `health`.':'Verified `WorldTile.Height` / `data.height` behavior and why `health` was wrong.', terms:'world tile height terrain generation map', href:'../api/worldtile-height/'},
  {cat:'ui', icon:'UI', level:'intermediate', title:ru?'Безопаснее клонировать UI':'Clone UI more safely', desc:ru?'Реальный кейс TerraForge: почему native clone падал и какой порядок оказался безопаснее.':'Real TerraForge case: why a native clone crashed and the safer order that worked.', terms:'ui button window clone null reference terraforge', href:'../case-studies/terraforge-safe-ui-cloning/'},
  {cat:'debug', icon:'LOG', level:'beginner', title:ru?'Разобрать Player.log':'Read Player.log', desc:ru?'Вытащить версии, загруженные моды и известные сигнатуры ошибок прямо в браузере.':'Extract versions, loaded mods, and known error signatures directly in the browser.', terms:'log error player log debug diagnose crash compile', href:'../workbench/log-analyzer/'},
  {cat:'debug', icon:'LOOP', level:'intermediate', title:ru?'Найти рекурсивный StackOverflow':'Find a recursive StackOverflow', desc:ru?'Как отличить recursive initialization от случайного краша и где разрывать цикл.':'How to recognize recursive initialization and where to break the cycle.', terms:'stack overflow recursion crash government init', href:'../troubleshooting/stack-overflow-recursive-initialization/'},
];
---

<div class="workbench-tool recipe-finder" data-recipe-finder>
  <div class="tool-head tool-head-polished">
    <div class="tool-identity">
      <span class="tool-symbol tool-symbol-large">HOW</span>
      <div>
        <span class="tool-kicker">{ru ? 'Практика' : 'Practical'}</span>
        <h2>{t.title}</h2>
        <p>{t.intro}</p>
      </div>
    </div>
    <span class="verified-pill">WBML-backed</span>
  </div>

  <div class="api-search-row finder-search-row">
    <input type="search" data-recipe-search placeholder={t.search} />
    <div class="filter-pills filter-pills-scroll" aria-label={ru ? 'Категории рецептов' : 'Recipe categories'}>
      <button type="button" class="filter-pill active" data-filter="all">{t.all}</button>
      <button type="button" class="filter-pill" data-filter="start">{t.start}</button>
      <button type="button" class="filter-pill" data-filter="data">{t.data}</button>
      <button type="button" class="filter-pill" data-filter="events">{t.events}</button>
      <button type="button" class="filter-pill" data-filter="actions">{t.actions}</button>
      <button type="button" class="filter-pill" data-filter="world">{t.world}</button>
      <button type="button" class="filter-pill" data-filter="ui">{t.ui}</button>
      <button type="button" class="filter-pill" data-filter="debug">{t.debug}</button>
    </div>
  </div>

  <div class="finder-summary">
    <span data-recipe-count>{t.shown} {items.length} {t.of} {items.length}</span>
    <button type="button" class="mini-button" data-recipe-clear>{t.clear}</button>
  </div>

  <div class="recipe-grid" data-recipe-results>
    {items.map((item) => (
      <a class="recipe-card" href={item.href} data-cat={item.cat} data-search={`${item.title} ${item.desc} ${item.terms}`.toLowerCase()}>
        <span class="recipe-icon">{item.icon}</span>
        <div class="recipe-body">
          <div class="recipe-meta"><span>{item.level === 'beginner' ? `NEW · ${t.beginner}` : `MID · ${t.intermediate}`}</span></div>
          <strong>{item.title}</strong>
          <p>{item.desc}</p>
          <span class="recipe-open">{t.open}</span>
        </div>
      </a>
    ))}
    <div class="empty-good" data-recipe-empty hidden>{t.empty}</div>
  </div>
</div>

<script define:vars={{ t, total: items.length }}>
  for (const root of document.querySelectorAll('[data-recipe-finder]')) {
    if (root.dataset.ready === '1') continue;
    root.dataset.ready = '1';
    const input = root.querySelector('[data-recipe-search]');
    const cards = Array.from(root.querySelectorAll('.recipe-card'));
    const empty = root.querySelector('[data-recipe-empty]');
    const count = root.querySelector('[data-recipe-count]');
    const clear = root.querySelector('[data-recipe-clear]');
    let filter = 'all';

    const update = () => {
      const q = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const okFilter = filter === 'all' || card.dataset.cat === filter;
        const okQuery = !q || card.dataset.search.includes(q);
        card.hidden = !(okFilter && okQuery);
        if (!card.hidden) visible++;
      }
      empty.hidden = visible !== 0;
      if (count) count.textContent = `${t.shown} ${visible} ${t.of} ${total}`;
    };

    input?.addEventListener('input', update);
    for (const button of root.querySelectorAll('[data-filter]')) {
      button.addEventListener('click', () => {
        filter = button.dataset.filter || 'all';
        for (const b of root.querySelectorAll('[data-filter]')) b.classList.toggle('active', b === button);
        update();
      });
    }
    clear?.addEventListener('click', () => {
      if (input) input.value = '';
      filter = 'all';
      for (const b of root.querySelectorAll('[data-filter]')) b.classList.toggle('active', b.dataset.filter === 'all');
      update();
      input?.focus();
    });
    update();
  }
</script>
